  petty_cash_fund tb_petty_cash_fund @relation(fields: [petty_cash_fund_id], references: [id])

  @@unique([voucher_no, deleted_at], map: "petty_exp_no_u")
  @@index([petty_cash_fund_id], map: "petty_exp_fund_idx")
}

model tb_bank_statement {
  doc_version        Int      @default(0) @db.Integer
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_account_id    String   @db.Uuid
  statement_date     DateTime @db.Date
  period_start_date  DateTime @db.Date
  period_end_date    DateTime @db.Date
  opening_balance    Decimal  @db.Decimal(18, 2)
  closing_balance    Decimal  @db.Decimal(18, 2)
  total_deposits     Decimal  @default(0) @db.Decimal(18, 2)
  total_withdrawals  Decimal  @default(0) @db.Decimal(18, 2)
