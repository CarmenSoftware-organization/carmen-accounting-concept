  tb_gl_jv_detail_tb_gl_jv_detail_base_currency_idTotb_currency tb_gl_jv_detail[]                     @relation("tb_gl_jv_detail_base_currency_idTotb_currency")
  tb_gl_jv_detail_tb_gl_jv_detail_currency_idTotb_currency      tb_gl_jv_detail[]                     @relation("tb_gl_jv_detail_currency_idTotb_currency")
