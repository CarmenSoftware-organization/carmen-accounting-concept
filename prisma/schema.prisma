  deleted_by_id String?   @db.Uuid

  bank_account tb_bank_account @relation(fields: [bank_account_id], references: [id])

  lines           tb_bank_statement_line[]
  reconciliations tb_bank_reconciliation[]

  @@index([bank_account_id, statement_date], map: "stmt_acct_date_idx")
