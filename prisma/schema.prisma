// ==============================================================================
// Carmen Cloud ERP — Full-Scope Accounting System Prisma Schema
// USALI 12th Edition & Thai Tax (TFRS / Revenue Dept) Compliant
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ==============================================================================
// 1. ENUMS
// ==============================================================================

enum enum_account_type {
  asset
  liability
  equity
  revenue
  expense
}

enum enum_account_normal_balance {
  debit
  credit
}

enum enum_dimension_requirement {
  mandatory
  optional
  prohibited
}

enum enum_dimension_code {
  market
  sales
  project
  event
  location
  channel
  guest_type
  custom
}

enum enum_fiscal_period_status {
  open
  soft_closed
  closed
  locked
}

enum enum_journal_voucher_type {
  general
  adjustment
  recurring
  auto_reversal
  closing
  subledger_ap
  subledger_ar
  subledger_fa
  subledger_cb
  intercompany
}

enum enum_journal_voucher_status {
  draft
  submitted
  approved
  posted
  voided
  reversed
}

enum enum_ap_invoice_type {
  standard
  prepayment
  credit_note
  debit_note
}

enum enum_ap_invoice_status {
  draft
  pending_matching
  submitted
  approved
  posted
  partially_paid
  paid
  voided
}

enum enum_ap_payment_status {
  draft
  submitted
  approved
  posted
  reconciled
  voided
}

enum enum_payment_method {
  bank_transfer
  cheque
  cash
  credit_card
  direct_debit
  promtpay
}

enum enum_ar_invoice_type {
  standard
  folio_billing
  city_ledger
  banquet_event
  deposit
  credit_note
  debit_note
}

enum enum_ar_invoice_status {
  draft
  submitted
  approved
  posted
  partially_paid
  paid
  bad_debt
  voided
}

enum enum_ar_receipt_status {
  draft
  submitted
  approved
  posted
  reconciled
  voided
}

enum enum_depreciation_method {
  straight_line
  declining_balance
  sum_of_years
  no_depreciation
}

enum enum_asset_status {
  in_service
  under_maintenance
  fully_depreciated
  disposed
  written_off
}

enum enum_asset_disposal_type {
  sale
  scrapping
  write_off
  donation
  trade_in
}

enum enum_tax_invoice_type {
  input_vat // ภาษีซื้อ (AP)
  output_vat // ภาษีขาย (AR)
}

enum enum_tax_status {
  undue_suspense // ภาษีรอยื่น / ภาษียังไม่ถึงกำหนด
  claimed // ยื่นภาษีแล้ว (ภ.พ.30)
  deferred // ขอเลื่อนยื่น (ภายใน 6 เดือน)
  voided // ยกเลิก
}

enum enum_wht_form_type {
  pnd_1
  pnd_2
  pnd_3 // บุคคลธรรมดา
  pnd_53 // นิติบุคคล
  pnd_54 // จ่ายไปต่างประเทศ
}

enum enum_wht_condition {
  deducted_at_source // 1 = หัก ณ ที่จ่าย
  paid_for_every_time // 2 = ออกให้ตลอดไป
  paid_one_time // 3 = ออกให้ครั้งเดียว
}

enum enum_bank_account_type {
  current
  savings
  fixed_deposit
  petty_cash
}

enum enum_reconciliation_status {
  unmatched
  matched
  auto_matched
  manually_cleared
  disputed
}

enum enum_budget_status {
  draft
  submitted
  approved
  active
  revised
  archived
}

enum enum_intercompany_status {
  draft
  pending_approval
  confirmed
  settled
  cancelled
}

// ==============================================================================
// 2. CORE MASTER DATA: CHART OF ACCOUNTS & DIMENSIONS
// ==============================================================================

model tb_chart_of_accounts {
  doc_version       Int                         @default(0) @db.Integer
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_code      String                      @db.VarChar(50)
  account_name_en   String                      @db.VarChar(255)
  account_name_th   String?                     @db.VarChar(255)
  description       String?                     @db.VarChar
  account_type      enum_account_type
  normal_balance    enum_account_normal_balance
  parent_account_id String?                     @db.Uuid
  level             Int                         @default(1) @db.Integer
  is_header         Boolean                     @default(false)
  is_postable       Boolean                     @default(true)
  is_active         Boolean                     @default(true)

  // USALI 12th Edition Categorization
  usali_schedule_code   String? @db.VarChar(50) // e.g. "OPER-RMS", "OPER-FB", "UNDIST-AG"
  usali_department_code String? @db.VarChar(50) // e.g. "10", "20", "30"
  report_group_code     String? @db.VarChar(50) // Balance Sheet / P&L grouping

  info          Json?     @default("{}") @db.JsonB
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  // Self-referencing tree
  parent_account tb_chart_of_accounts?  @relation("AccountHierarchy", fields: [parent_account_id], references: [id])
  child_accounts tb_chart_of_accounts[] @relation("AccountHierarchy")

  // Dimension validation rules
  dimension_rules tb_account_dimension_rule[]

  // References from General Ledger
  journal_voucher_lines tb_journal_voucher_line[]
  gl_entries            tb_gl_entry[]

  // References from Subledgers
  ap_invoice_lines      tb_ap_invoice_line[]
  ar_invoice_lines      tb_ar_invoice_line[]
  bank_accounts         tb_bank_account[]
  petty_cash_funds      tb_petty_cash_fund[]
  fixed_assets_cost     tb_fixed_asset[]          @relation("AssetCostAccount")
  fixed_assets_acc_dep  tb_fixed_asset[]          @relation("AssetAccDepAccount")
  fixed_assets_dep_exp  tb_fixed_asset[]          @relation("AssetDepExpAccount")
  asset_categories_cost tb_asset_category[]       @relation("CategoryCostAccount")
  asset_categories_acc  tb_asset_category[]       @relation("CategoryAccDepAccount")
  asset_categories_exp  tb_asset_category[]       @relation("CategoryDepExpAccount")
  budget_lines          tb_budget_line[]
  intercompany_due_to   tb_intercompany_partner[] @relation("PartnerDueToAccount")
  intercompany_due_from tb_intercompany_partner[] @relation("PartnerDueFromAccount")

  @@unique([account_code, deleted_at], map: "coa_account_code_u")
  @@index([account_code], map: "coa_account_code_idx")
  @@index([parent_account_id], map: "coa_parent_id_idx")
  @@index([account_type], map: "coa_type_idx")
  @@index([usali_schedule_code], map: "coa_usali_idx")
}

model tb_dimension_type {
  doc_version Int                 @default(0) @db.Integer
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        enum_dimension_code
  custom_name String?             @db.VarChar(100)
  description String?             @db.VarChar
  is_active   Boolean             @default(true)
  sort_order  Int                 @default(0)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  dimension_values        tb_dimension_value[]
  account_dimension_rules tb_account_dimension_rule[]

  @@unique([code, custom_name, deleted_at], map: "dim_type_code_custom_u")
}

model tb_dimension_value {
  doc_version       Int     @default(0) @db.Integer
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dimension_type_id String  @db.Uuid
  code              String  @db.VarChar(50)
  name_en           String  @db.VarChar(255)
  name_th           String? @db.VarChar(255)
  description       String? @db.VarChar
  is_active         Boolean @default(true)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  dimension_type tb_dimension_type @relation(fields: [dimension_type_id], references: [id])

  jv_line_dimensions  tb_journal_voucher_line_dimension[]
  gl_entry_dimensions tb_gl_entry_dimension[]
  ap_line_dimensions  tb_ap_invoice_line_dimension[]
  ar_line_dimensions  tb_ar_invoice_line_dimension[]

  @@unique([dimension_type_id, code, deleted_at], map: "dim_value_code_u")
  @@index([dimension_type_id], map: "dim_value_type_id_idx")
}

model tb_account_dimension_rule {
  doc_version       Int                        @default(0) @db.Integer
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id        String                     @db.Uuid
  dimension_type_id String                     @db.Uuid
  requirement       enum_dimension_requirement @default(optional)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  account        tb_chart_of_accounts @relation(fields: [account_id], references: [id])
  dimension_type tb_dimension_type    @relation(fields: [dimension_type_id], references: [id])

  @@unique([account_id, dimension_type_id, deleted_at], map: "acct_dim_rule_u")
}

// ==============================================================================
// 3. FISCAL YEARS & PERIODS
// ==============================================================================

model tb_fiscal_year {
  doc_version Int      @default(0) @db.Integer
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year_number Int      @db.Integer // e.g. 2026
  year_name   String   @db.VarChar(50) // e.g. "FY 2026"
  start_date  DateTime @db.Date
  end_date    DateTime @db.Date
  is_closed   Boolean  @default(false)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  fiscal_periods tb_fiscal_period[]
  budget_plans   tb_budget_plan[]

  @@unique([year_number, deleted_at], map: "fiscal_year_number_u")
}

model tb_fiscal_period {
  doc_version    Int      @default(0) @db.Integer
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscal_year_id String   @db.Uuid
  period_number  Int      @db.Integer // 1 to 12 (or 13 for year-end adj)
  period_name    String   @db.VarChar(50) // e.g. "Jan 2026"
  start_date     DateTime @db.Date
  end_date       DateTime @db.Date

  // Granular per-module period controls
  gl_status enum_fiscal_period_status @default(open)
  ap_status enum_fiscal_period_status @default(open)
  ar_status enum_fiscal_period_status @default(open)
  fa_status enum_fiscal_period_status @default(open)
  cb_status enum_fiscal_period_status @default(open)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  fiscal_year tb_fiscal_year @relation(fields: [fiscal_year_id], references: [id])

  journal_vouchers        tb_journal_voucher[]
  gl_entries              tb_gl_entry[]
  period_close_histories  tb_period_close_history[]
  asset_depreciation_runs tb_asset_depreciation_run[]
  budget_lines            tb_budget_line[]

  @@unique([fiscal_year_id, period_number, deleted_at], map: "fiscal_period_num_u")
  @@index([start_date, end_date], map: "fiscal_period_dates_idx")
}

model tb_period_close_history {
  doc_version      Int                       @default(0) @db.Integer
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscal_period_id String                    @db.Uuid
  module           String                    @db.VarChar(20) // "GL", "AP", "AR", "FA", "CB"
  previous_status  enum_fiscal_period_status
  new_status       enum_fiscal_period_status
  reason           String?                   @db.VarChar
  performed_by_id  String                    @db.Uuid
  performed_at     DateTime                  @default(now()) @db.Timestamptz(6)

  fiscal_period tb_fiscal_period @relation(fields: [fiscal_period_id], references: [id])

  @@index([fiscal_period_id, module], map: "period_close_hist_idx")
}

// ==============================================================================
// 4. GENERAL LEDGER (GL): TWO-TIER VOUCHER & LEDGER
// ==============================================================================

model tb_journal_voucher {
  doc_version      Int                         @default(0) @db.Integer
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_no       String                      @db.VarChar(50)
  voucher_date     DateTime                    @db.Date
  posting_date     DateTime                    @db.Date
  fiscal_period_id String                      @db.Uuid
  voucher_type     enum_journal_voucher_type   @default(general)
  status           enum_journal_voucher_status @default(draft)
  description      String?                     @db.VarChar
  reference_no     String?                     @db.VarChar(100)

  // Subledger lineage tracking
  source_module String? @db.VarChar(50) // "AP", "AR", "FA", "CB", "INTERCOMPANY"
  source_type   String? @db.VarChar(50) // "INVOICE", "PAYMENT", "DEPRECIATION", etc.
  source_id     String? @db.Uuid // Originating document ID

  // Auto-reversal instructions
  is_reversal         Boolean   @default(false)
  reversal_voucher_id String?   @db.Uuid
  auto_reverse_date   DateTime? @db.Date

  // Currency & Totals (Base / Functional Currency)
  base_currency_id String  @db.Uuid
  total_debit      Decimal @default(0) @db.Decimal(18, 2)
  total_credit     Decimal @default(0) @db.Decimal(18, 2)

  // Workflow / Approval
  submitted_at    DateTime? @db.Timestamptz(6)
  submitted_by_id String?   @db.Uuid
  approved_at     DateTime? @db.Timestamptz(6)
  approved_by_id  String?   @db.Uuid
  posted_at       DateTime? @db.Timestamptz(6)
  posted_by_id    String?   @db.Uuid
  voided_at       DateTime? @db.Timestamptz(6)
  voided_by_id    String?   @db.Uuid

  info          Json?     @default("{}") @db.JsonB
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  fiscal_period    tb_fiscal_period     @relation(fields: [fiscal_period_id], references: [id])
  reversal_voucher tb_journal_voucher?  @relation("ReversalPair", fields: [reversal_voucher_id], references: [id])
  reversed_by      tb_journal_voucher[] @relation("ReversalPair")

  lines      tb_journal_voucher_line[]
  gl_entries tb_gl_entry[]

  // Subledger relationships linking back to this voucher
  ap_invoices      tb_ap_invoice[]
  ap_payments      tb_ap_payment[]
  ar_invoices      tb_ar_invoice[]
  ar_receipts      tb_ar_receipt[]
  asset_dep_runs   tb_asset_depreciation_run[]
  asset_disposals  tb_asset_disposal[]
  tax_invoices     tb_tax_invoice[]
  wht_certificates tb_wht_certificate[]
  ic_origin_txs    tb_intercompany_transaction[] @relation("OriginVoucher")
  ic_target_txs    tb_intercompany_transaction[] @relation("TargetVoucher")

  @@unique([voucher_no, deleted_at], map: "jv_voucher_no_u")
  @@index([posting_date], map: "jv_posting_date_idx")
  @@index([fiscal_period_id], map: "jv_period_idx")
  @@index([status], map: "jv_status_idx")
  @@index([source_module, source_id], map: "jv_source_idx")
}

model tb_journal_voucher_line {
  doc_version        Int     @default(0) @db.Integer
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journal_voucher_id String  @db.Uuid
  line_number        Int     @db.Integer
  account_id         String  @db.Uuid
  department_id      String? @db.Uuid // Cost Center (tb_department)
  description        String? @db.VarChar

  // Currency & Rate Snapshot
  currency_id   String  @db.Uuid
  exchange_rate Decimal @default(1.000000) @db.Decimal(18, 6)

  // Foreign / Transaction Currency Amounts
  foreign_debit  Decimal @default(0) @db.Decimal(18, 2)
  foreign_credit Decimal @default(0) @db.Decimal(18, 2)

  // Functional / Base Currency Amounts
  base_debit  Decimal @default(0) @db.Decimal(18, 2)
  base_credit Decimal @default(0) @db.Decimal(18, 2)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  journal_voucher tb_journal_voucher   @relation(fields: [journal_voucher_id], references: [id], onDelete: Cascade)
  account         tb_chart_of_accounts @relation(fields: [account_id], references: [id])

  line_dimensions tb_journal_voucher_line_dimension[]

  @@index([journal_voucher_id], map: "jv_line_jv_id_idx")
  @@index([account_id], map: "jv_line_account_idx")
  @@index([department_id], map: "jv_line_dept_idx")
}

model tb_journal_voucher_line_dimension {
  id                      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journal_voucher_line_id String @db.Uuid
  dimension_value_id      String @db.Uuid

  journal_voucher_line tb_journal_voucher_line @relation(fields: [journal_voucher_line_id], references: [id], onDelete: Cascade)
  dimension_value      tb_dimension_value      @relation(fields: [dimension_value_id], references: [id])

  @@unique([journal_voucher_line_id, dimension_value_id], map: "jv_line_dim_u")
  @@index([dimension_value_id], map: "jv_line_dim_val_idx")
}

model tb_gl_entry {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_number       BigInt   @default(autoincrement())
  journal_voucher_id String   @db.Uuid
  fiscal_period_id   String   @db.Uuid
  posting_date       DateTime @db.Date
  account_id         String   @db.Uuid
  department_id      String?  @db.Uuid // Cost Center (tb_department)
  description        String?  @db.VarChar

  // Currency & Rate Snapshot
  currency_id   String  @db.Uuid
  exchange_rate Decimal @default(1.000000) @db.Decimal(18, 6)

  // Transaction Currency
  foreign_debit  Decimal @default(0) @db.Decimal(18, 2)
  foreign_credit Decimal @default(0) @db.Decimal(18, 2)

  // Base / Functional Currency
  base_debit  Decimal @default(0) @db.Decimal(18, 2)
  base_credit Decimal @default(0) @db.Decimal(18, 2)

  posted_at    DateTime @default(now()) @db.Timestamptz(6)
  posted_by_id String   @db.Uuid

  journal_voucher tb_journal_voucher   @relation(fields: [journal_voucher_id], references: [id])
  fiscal_period   tb_fiscal_period     @relation(fields: [fiscal_period_id], references: [id])
  account         tb_chart_of_accounts @relation(fields: [account_id], references: [id])

  dimensions tb_gl_entry_dimension[]

  @@index([posting_date], map: "gl_posting_date_idx")
  @@index([account_id, posting_date], map: "gl_account_date_idx")
  @@index([fiscal_period_id], map: "gl_period_idx")
  @@index([department_id], map: "gl_dept_idx")
  @@index([journal_voucher_id], map: "gl_jv_idx")
}

model tb_gl_entry_dimension {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gl_entry_id        String @db.Uuid
  dimension_value_id String @db.Uuid

  gl_entry        tb_gl_entry        @relation(fields: [gl_entry_id], references: [id], onDelete: Cascade)
  dimension_value tb_dimension_value @relation(fields: [dimension_value_id], references: [id])

  @@unique([gl_entry_id, dimension_value_id], map: "gl_entry_dim_u")
  @@index([dimension_value_id], map: "gl_entry_dim_val_idx")
}

model tb_fx_revaluation_run {
  doc_version           Int      @default(0) @db.Integer
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscal_period_id      String   @db.Uuid
  revaluation_date      DateTime @db.Date
  currency_id           String   @db.Uuid
  closing_rate          Decimal  @db.Decimal(18, 6)
  total_unrealized_gain Decimal  @default(0) @db.Decimal(18, 2)
  total_unrealized_loss Decimal  @default(0) @db.Decimal(18, 2)
  journal_voucher_id    String?  @db.Uuid

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid

  @@index([fiscal_period_id], map: "fx_reval_period_idx")
}

// ==============================================================================
// 5. ACCOUNTS PAYABLE (AP)
// ==============================================================================

model tb_ap_invoice {
  doc_version       Int                    @default(0) @db.Integer
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_no        String                 @db.VarChar(50) // Internal AP voucher no
  vendor_invoice_no String                 @db.VarChar(100) // Supplier's invoice no
  invoice_type      enum_ap_invoice_type   @default(standard)
  status            enum_ap_invoice_status @default(draft)
  vendor_id         String                 @db.Uuid // tb_vendor in tenant DB
  invoice_date      DateTime               @db.Date
  posting_date      DateTime               @db.Date
  due_date          DateTime               @db.Date
  credit_term_days  Int                    @default(30) @db.Integer
  description       String?                @db.VarChar

  // Currency
  currency_id   String  @db.Uuid
  exchange_rate Decimal @default(1.000000) @db.Decimal(18, 6)

  // Totals (Foreign Currency)
  foreign_subtotal    Decimal @default(0) @db.Decimal(18, 2)
  foreign_discount    Decimal @default(0) @db.Decimal(18, 2)
  foreign_tax_amount  Decimal @default(0) @db.Decimal(18, 2)
  foreign_grand_total Decimal @default(0) @db.Decimal(18, 2)

  // Totals (Base / Functional Currency)
  base_subtotal    Decimal @default(0) @db.Decimal(18, 2)
