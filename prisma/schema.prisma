model tb_intercompany_partner {
  doc_version         Int     @default(0) @db.Integer
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_bu_id       String  @db.Uuid // Target BU in platform schema
  partner_bu_code     String  @db.VarChar(50)
  partner_name        String  @db.VarChar(255)
  due_to_account_id   String  @db.Uuid // COA Liability: Intercompany Due To
  due_from_account_id String  @db.Uuid // COA Asset: Intercompany Due From
  is_active           Boolean @default(true)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  due_to_account   tb_chart_of_accounts @relation("PartnerDueToAccount", fields: [due_to_account_id], references: [id])
  due_from_account tb_chart_of_accounts @relation("PartnerDueFromAccount", fields: [due_from_account_id], references: [id])

  @@unique([partner_bu_id, deleted_at], map: "ic_partner_bu_u")
}

model tb_intercompany_transaction {
  doc_version      Int                      @default(0) @db.Integer
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_no   String                   @db.VarChar(50)
  transaction_date DateTime                 @db.Date
  origin_bu_id     String                   @db.Uuid
  target_bu_id     String                   @db.Uuid
  currency_id      String                   @db.Uuid
  amount           Decimal                  @db.Decimal(18, 2)
  status           enum_intercompany_status @default(pending_approval)
  description      String?                  @db.VarChar

  origin_jv_id String? @db.Uuid // Reciprocal JV in originating BU
  target_jv_id String? @db.Uuid // Reciprocal JV in target BU

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  origin_jv tb_journal_voucher? @relation("OriginVoucher", fields: [origin_jv_id], references: [id])
  target_jv tb_journal_voucher? @relation("TargetVoucher", fields: [target_jv_id], references: [id])

  @@unique([transaction_no, deleted_at], map: "ic_tx_no_u")
  @@index([origin_bu_id, target_bu_id], map: "ic_tx_bus_idx")
  @@index([status], map: "ic_tx_status_idx")
