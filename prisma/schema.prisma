// source: schema.prisma:3055-3094
model tb_chart_of_accounts {
  doc_version            Int                              @default(0) @db.Integer
  id                     String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                           @db.VarChar
  description_1          String                           @db.VarChar
  description_2          String?                          @db.VarChar
  nature                 enum_chart_of_accounts_nature
  type                   enum_chart_of_accounts_type
  // nullable ตอน migrate เพราะแถวเดิมไม่มีค่า — DTO บังคับตอน create และตอน update ถ้ายัง null (spec §3.1)
  category               enum_chart_of_accounts_category?
  reverse_sign           Boolean                          @default(false)
  use_in                 enum_chart_of_accounts_use_in[]  @default([])
  // true = บรรทัด JV ต้องมี cost_center_id และถ้ามีแถวใน tb_cost_center_account ต้องเป็นตัวที่ผูกไว้เท่านั้น
  is_require_cost_center Boolean                          @default(false)
  // 1 บัญชี : 1 กลุ่ม (AR-002) — ผูกได้เฉพาะ leaf ของ tb_gl_account_group (service บังคับ)
  account_group_id       String?                          @db.Uuid
  is_active              Boolean?                         @default(true)

  note      String? @db.VarChar
  info      Json?   @default("{}") @db.JsonB
  dimension Json?   @default("[]") @db.JsonB

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  tb_cost_center_account       tb_cost_center_account[]
  tb_gl_account_group          tb_gl_account_group?           @relation(fields: [account_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tb_tax_profile               tb_tax_profile[]
  tb_gl_account_dimension_rule tb_gl_account_dimension_rule[]
  tb_bank_account              tb_bank_account[]

  @@unique([code, deleted_at], map: "chartofaccounts_code_u")
  @@index([code], map: "chartofaccounts_code_idx")
  @@index([description_1], map: "chartofaccounts_description_1_idx")
  @@index([account_group_id], map: "chartofaccounts_account_group_id_idx")
}

