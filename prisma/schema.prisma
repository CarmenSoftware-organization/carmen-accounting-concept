  imported_file_name String?  @db.VarChar(255)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  // bank_account_id -> tb_bank_account.id  (implemented model; @relation omitted, see header)

  lines           tb_bank_statement_line[]
  reconciliations tb_bank_reconciliation[]

  @@index([bank_account_id, statement_date], map: "stmt_acct_date_idx")
}

model tb_bank_statement_line {
  doc_version       Int       @default(0) @db.Integer
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_statement_id String    @db.Uuid
  transaction_date  DateTime  @db.Date
  value_date        DateTime? @db.Date
  reference_no      String?   @db.VarChar(100)
  description       String?   @db.VarChar
  debit_amount      Decimal   @default(0) @db.Decimal(18, 2) // Withdrawal
  credit_amount     Decimal   @default(0) @db.Decimal(18, 2) // Deposit
  running_balance   Decimal?  @db.Decimal(18, 2)
  is_reconciled     Boolean   @default(false)

  bank_statement       tb_bank_statement             @relation(fields: [bank_statement_id], references: [id], onDelete: Cascade)
  reconciliation_items tb_bank_reconciliation_item[]

  @@index([bank_statement_id], map: "stmt_line_stmt_idx")
  @@index([transaction_date], map: "stmt_line_date_idx")
}

model tb_bank_reconciliation {
  doc_version         Int      @default(0) @db.Integer
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_account_id     String   @db.Uuid
  bank_statement_id   String?  @db.Uuid
  reconciliation_date DateTime @db.Date
  statement_balance   Decimal  @db.Decimal(18, 2)
  gl_book_balance     Decimal  @db.Decimal(18, 2)
  unpresented_cheques Decimal  @default(0) @db.Decimal(18, 2)
  deposits_in_transit Decimal  @default(0) @db.Decimal(18, 2)
  variance_difference Decimal  @default(0) @db.Decimal(18, 2)
  is_balanced         Boolean  @default(false)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid

  // bank_account_id -> tb_bank_account.id  (implemented model; @relation omitted, see header)
  bank_statement tb_bank_statement? @relation(fields: [bank_statement_id], references: [id])

  items tb_bank_reconciliation_item[]

  @@index([bank_account_id, reconciliation_date], map: "bank_rec_acct_date_idx")
}

model tb_bank_reconciliation_item {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_reconciliation_id String                     @db.Uuid
  bank_statement_line_id String?                    @db.Uuid
  ap_payment_id          String?                    @db.Uuid
  ar_receipt_id          String?                    @db.Uuid
  status                 enum_reconciliation_status @default(unmatched)
  matched_amount         Decimal                    @db.Decimal(18, 2)
  cleared_date           DateTime?                  @db.Date
  notes                  String?                    @db.VarChar

  bank_reconciliation tb_bank_reconciliation  @relation(fields: [bank_reconciliation_id], references: [id], onDelete: Cascade)
  bank_statement_line tb_bank_statement_line? @relation(fields: [bank_statement_line_id], references: [id])
  // ap_payment_id -> tb_ap_payment.id  (implemented model; @relation omitted, see header)
  ar_receipt          tb_ar_receipt?          @relation(fields: [ar_receipt_id], references: [id])

  @@index([bank_reconciliation_id], map: "rec_item_rec_idx")
  @@index([bank_statement_line_id], map: "rec_item_stmt_line_idx")
}

// ---- Fixed Assets (DRAFT) ----------------------------------------------------

model tb_asset_category {
  doc_version         Int                      @default(0) @db.Integer
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_code       String                   @db.VarChar(50) // e.g. "BLD", "FF&E", "VEH", "IT"
  category_name       String                   @db.VarChar(255)
  depreciation_method enum_depreciation_method @default(straight_line)
  useful_life_years   Decimal                  @db.Decimal(5, 2) // e.g. 5.00 years
  depreciation_rate   Decimal?                 @db.Decimal(5, 2) // % per annum

  // GL Account Mappings
  asset_cost_account_id String @db.Uuid // COA Asset Cost
  acc_dep_account_id    String @db.Uuid // COA Accumulated Depreciation (contra-asset)
  dep_exp_account_id    String @db.Uuid // COA Depreciation Expense

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  // asset_cost_account_id -> tb_chart_of_accounts.id  (implemented model; @relation omitted, see header)
  // acc_dep_account_id -> tb_chart_of_accounts.id  (implemented model; @relation omitted, see header)
  // dep_exp_account_id -> tb_chart_of_accounts.id  (implemented model; @relation omitted, see header)

  fixed_assets tb_fixed_asset[]

  @@unique([category_code, deleted_at], map: "asset_cat_code_u")
}

model tb_fixed_asset {
  doc_version   Int               @default(0) @db.Integer
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_code    String            @db.VarChar(50) // Barcode / Tag ID
  asset_name    String            @db.VarChar(255)
  category_id   String            @db.Uuid
  department_id String?           @db.Uuid // Custodian cost center (tb_department)
  location_id   String?           @db.Uuid // Physical location (tb_location)
  serial_number String?           @db.VarChar(100)
  barcode       String?           @db.VarChar(100)
  status        enum_asset_status @default(in_service)

  // Acquisition Details
  acquisition_date    DateTime                 @db.Date
  in_service_date     DateTime                 @db.Date
  currency_id         String                   @db.Uuid
  acquisition_cost    Decimal                  @db.Decimal(18, 2) // Historical cost
  salvage_value       Decimal                  @default(0) @db.Decimal(18, 2)
  useful_life_years   Decimal                  @db.Decimal(5, 2)
  depreciation_method enum_depreciation_method @default(straight_line)

  // Running Balances
  accumulated_depreciation Decimal @default(0) @db.Decimal(18, 2)
  net_book_value           Decimal @db.Decimal(18, 2)

  // GL Mapping overrides
  gl_cost_account_id    String @db.Uuid
  gl_acc_dep_account_id String @db.Uuid
  gl_dep_exp_account_id String @db.Uuid

  // Procurement origin link
  ap_invoice_id     String? @db.Uuid
  purchase_order_id String? @db.Uuid

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  category           tb_asset_category    @relation(fields: [category_id], references: [id])
  // gl_cost_account_id -> tb_chart_of_accounts.id  (implemented model; @relation omitted, see header)
  // gl_acc_dep_account_id -> tb_chart_of_accounts.id  (implemented model; @relation omitted, see header)
  // gl_dep_exp_account_id -> tb_chart_of_accounts.id  (implemented model; @relation omitted, see header)

  depreciation_entries tb_asset_depreciation_entry[]
  transfers            tb_asset_transfer[]
  disposals            tb_asset_disposal[]

  @@unique([asset_code, deleted_at], map: "fa_asset_code_u")
  @@index([category_id], map: "fa_cat_idx")
  @@index([department_id], map: "fa_dept_idx")
  @@index([status], map: "fa_status_idx")
}

model tb_asset_depreciation_run {
  doc_version        Int      @default(0) @db.Integer
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_no             String   @db.VarChar(50)
  fiscal_period_id   String   @db.Uuid
  run_date           DateTime @db.Date
  total_depreciation Decimal  @db.Decimal(18, 2)
  journal_voucher_id String?  @db.Uuid // Linked auto-generated JV
  is_posted          Boolean  @default(false)

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid

  // fiscal_period_id -> tb_gl_period.id  (implemented model; @relation omitted, see header)
  // journal_voucher_id -> tb_gl_jv_header.id  (implemented model; @relation omitted, see header)

  entries tb_asset_depreciation_entry[]

  @@unique([run_no], map: "asset_dep_run_no_u")
  @@index([fiscal_period_id], map: "asset_dep_period_idx")
}

model tb_asset_depreciation_entry {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  depreciation_run_id   String  @db.Uuid
  fixed_asset_id        String  @db.Uuid
  depreciation_amount   Decimal @db.Decimal(18, 2)
  prior_accumulated_dep Decimal @db.Decimal(18, 2)
  new_accumulated_dep   Decimal @db.Decimal(18, 2)
  new_net_book_value    Decimal @db.Decimal(18, 2)

  depreciation_run tb_asset_depreciation_run @relation(fields: [depreciation_run_id], references: [id], onDelete: Cascade)
  fixed_asset      tb_fixed_asset            @relation(fields: [fixed_asset_id], references: [id])

  @@index([depreciation_run_id], map: "dep_entry_run_idx")
  @@index([fixed_asset_id], map: "dep_entry_asset_idx")
}

model tb_asset_transfer {
  doc_version        Int      @default(0) @db.Integer
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fixed_asset_id     String   @db.Uuid
  transfer_date      DateTime @db.Date
  from_department_id String?  @db.Uuid
  to_department_id   String?  @db.Uuid
  from_location_id   String?  @db.Uuid
  to_location_id     String?  @db.Uuid
  reason             String?  @db.VarChar

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid

  fixed_asset tb_fixed_asset @relation(fields: [fixed_asset_id], references: [id])

  @@index([fixed_asset_id], map: "asset_trf_asset_idx")
}

model tb_asset_disposal {
  doc_version         Int                      @default(0) @db.Integer
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fixed_asset_id      String                   @db.Uuid
  disposal_date       DateTime                 @db.Date
  disposal_type       enum_asset_disposal_type @default(scrapping)
  sale_proceeds       Decimal                  @default(0) @db.Decimal(18, 2)
  cost_at_disposal    Decimal                  @db.Decimal(18, 2)
  acc_dep_at_disposal Decimal                  @db.Decimal(18, 2)
  net_book_value      Decimal                  @db.Decimal(18, 2)
  gain_or_loss        Decimal                  @db.Decimal(18, 2) // Positive = Gain, Negative = Loss
  journal_voucher_id  String?                  @db.Uuid

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid

  fixed_asset     tb_fixed_asset      @relation(fields: [fixed_asset_id], references: [id])
  // journal_voucher_id -> tb_gl_jv_header.id  (implemented model; @relation omitted, see header)

  @@index([fixed_asset_id], map: "asset_disp_asset_idx")
}

// ---- Tax (DRAFT) -------------------------------------------------------------

model tb_wht_certificate {
  doc_version         Int                @default(0) @db.Integer
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificate_no      String             @db.VarChar(50) // หนังสือรับรองการหักภาษี ณ ที่จ่าย (50 ทวิ)
  form_type           enum_wht_form_type @default(pnd_53)
  condition           enum_wht_condition @default(deducted_at_source)
  certificate_date    DateTime           @db.Date
  filing_period_month Int                @db.Integer
  filing_period_year  Int                @db.Integer

  // Payee / Vendor Details
  payee_name      String  @db.VarChar(255)
  payee_tax_id    String  @db.VarChar(50)
  payee_branch_no String  @default("00000") @db.VarChar(10)
  payee_address   String? @db.VarChar

  // Totals
  total_base_amount Decimal @db.Decimal(18, 2)
  total_wht_amount  Decimal @db.Decimal(18, 2)

  // Originating transactions
  ap_payment_id      String? @db.Uuid
  ap_invoice_id      String? @db.Uuid
  journal_voucher_id String? @db.Uuid

  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_by_id String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by_id String?   @db.Uuid

  // ap_payment_id -> tb_ap_payment.id  (implemented model; @relation omitted, see header)
  // ap_invoice_id -> tb_ap_invoice.id  (implemented model; @relation omitted, see header)
  // journal_voucher_id -> tb_gl_jv_header.id  (implemented model; @relation omitted, see header)

  lines tb_wht_certificate_line[]

  @@unique([certificate_no, deleted_at], map: "wht_cert_no_u")
  @@index([payee_tax_id], map: "wht_payee_tax_idx")
  @@index([filing_period_year, filing_period_month], map: "wht_period_idx")
}

model tb_wht_certificate_line {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wht_certificate_id String  @db.Uuid
  income_description String  @db.VarChar(255) // e.g. "ค่าบริการ (3%)", "ค่าเช่า (5%)"
  tax_rate           Decimal @db.Decimal(5, 2) // 1.00, 2.00, 3.00, 5.00
  base_amount        Decimal @db.Decimal(18, 2)
  wht_amount         Decimal @db.Decimal(18, 2)

  wht_certificate tb_wht_certificate @relation(fields: [wht_certificate_id], references: [id], onDelete: Cascade)

  @@index([wht_certificate_id], map: "wht_line_cert_idx")
}

