model tb_bank_reconciliation {
  doc_version         Int      @default(0) @db.Integer
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_account_id     String   @db.Uuid
  bank_statement_id   String?  @db.Uuid
  reconciliation_date DateTime @db.Date
  statement_balance   Decimal  @db.Decimal(18, 2)
  gl_book_balance     Decimal  @db.Decimal(18, 2)
  unpresented_cheques Decimal  @default(0) @db.Decimal(18, 2)
  deposits_in_transit Decimal  @default(0) @db.Decimal(18, 2)
